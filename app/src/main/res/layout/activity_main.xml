<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827">

    <!-- Normal App UI Container (hidden in fullscreen & PiP) -->
    <LinearLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#0F172A"
            android:elevation="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <!-- App Logo & Title -->
            <LinearLayout
                android:id="@+id/titleContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/dizilla_launcher_icon_1792242421690"
                    android:contentDescription="Dizilla Logo" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dizilla"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDomain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="dizilla.now"
                        android:textColor="#06B6D4"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action Controls: Refresh, Cast, AdBlock Shield -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- AdBlock Shield Badge Button -->
                <LinearLayout
                    android:id="@+id/btnAdBlockStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_round_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_shield_adblock"
                        android:contentDescription="AdBlock" />

                    <TextView
                        android:id="@+id/txtAdBlockBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="0"
                        android:textColor="#06B6D4"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Chromecast Button -->
                <androidx.mediarouter.app.MediaRouteButton
                    android:id="@+id/mediaRouteButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="2dp" />

                <!-- Refresh Button -->
                <ImageButton
                    android:id="@+id/btnRefresh"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_refresh"
                    android:contentDescription="Yenile" />

                <!-- Settings Button -->
                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="Ayarlar" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Thin Page Loading ProgressBar -->
        <ProgressBar
            android:id="@+id/pageProgressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#1E293B"
            android:progressTint="#06B6D4"
            android:visibility="gone" />

        <!-- Web Content Layout with Pull to Refresh -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <WebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#111827" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- "Bağlantı Yok" Error View -->
            <LinearLayout
                android:id="@+id/errorContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#111827"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_wifi_off"
                    android:contentDescription="Bağlantı Yok" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Bağlantı Yok"
                    android:textColor="#F3F4F6"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtErrorMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Dizilla sitesine bağlanılamadı. Lütfen internet bağlantınızı kontrol edip tekrar deneyin."
                    android:textColor="#9CA3AF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_button_gradient"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="Tekrar Dene"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Detected Video Cast Notification Bar -->
            <LinearLayout
                android:id="@+id/castStreamBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#0F172ACC"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_pip"
                    android:contentDescription="Cast"
                    app:tint="#06B6D4" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Video Akışı Algılandı"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCastStreamInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chromecast cihazınıza aktarabilirsiniz"
                        android:textColor="#9CA3AF"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCastNow"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_button_gradient"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="TV'de Oynat"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCloseCastBanner"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_fullscreen_exit"
                    android:contentDescription="Kapat"
                    app:tint="#9CA3AF" />
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

    <!-- Fullscreen Video Container Overlay -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <!-- Custom Video View gets inserted here -->

        <!-- Fullscreen Top Overlay Controls -->
        <RelativeLayout
            android:id="@+id/fullscreenOverlayControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#66000000"
            android:padding="8dp">

            <!-- Exit Fullscreen Button -->
            <ImageButton
                android:id="@+id/btnExitFullscreen"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_fullscreen_exit"
                android:contentDescription="Tam Ekrandan Çık" />

            <!-- PiP Button in Fullscreen -->
            <ImageButton
                android:id="@+id/btnPipFullscreen"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pip"
                android:contentDescription="PiP Modu" />
        </RelativeLayout>
    </FrameLayout>

    <!-- Jetpack Compose Settings Overlay -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeSettingsView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
