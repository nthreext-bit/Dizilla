<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ SplashScreen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#111827</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/dizilla_launcher_icon_1792242421690</item>
        <item name="postSplashScreenTheme">@style/Theme.Dizilla</item>
    </style>

    <!-- Main Application Theme (AppCompat for Cast MediaRoute support) -->
    <style name="Theme.Dizilla" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#111827</item>
        <item name="colorPrimary">#06B6D4</item>
        <item name="colorPrimaryDark">#0F172A</item>
        <item name="colorAccent">#8B5CF6</item>
        <item name="android:statusBarColor">#111827</item>
        <item name="android:navigationBarColor">#111827</item>
    </style>

    <!-- Dialog / BottomSheet Theme -->
    <style name="Theme.Dizilla.Dialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">#1F2937</item>
    </style>

</resources>
