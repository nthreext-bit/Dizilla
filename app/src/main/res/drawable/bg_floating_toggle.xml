<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state (TV D-Pad remote or keyboard) -->
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#E60F172A" />
            <stroke android:width="2dp" android:color="#06B6D4" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#F20F172A" />
            <stroke android:width="1.5dp" android:color="#06B6D4" />
        </shape>
    </item>
    <!-- Normal state: sleek semi-transparent dark circle with subtle border -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#990F172A" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
